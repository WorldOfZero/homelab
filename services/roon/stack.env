COMPOSE_PROJECT_NAME=roon

# Macvlan settings for the roon-lan network (#diagnose-roon-disconnects).
# All four must be set or the deploy fails on purpose — wrong values here put Roon on the
# wrong network silently.

# The physical LAN NIC on minerva. Verify on the host with: ip route get 192.168.1.1
# (the "dev" field).
ROON_MACVLAN_PARENT=eno1

# The LAN. 192.168.1.0/24 inferred from services/prometheus/prometheus.yml.
ROON_MACVLAN_SUBNET=192.168.1.0/24
ROON_MACVLAN_GATEWAY=192.168.1.1

# Static IP for the Roon container on the LAN. Macvlan does not use DHCP: pick an address
# that is unused and OUTSIDE the router's DHCP range (or reserve it on the router), then
# point Roon remotes at it once after the switch.
ROON_MACVLAN_IP=192.168.1.212
