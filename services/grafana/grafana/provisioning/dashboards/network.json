{
  "uid": "network",
  "title": "Network",
  "description": "minerva traffic, tailnet paths, Wi-Fi clients and Roon symptoms.",
  "tags": [
    "homelab",
    "ops",
    "network"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
    "list": [
      {
        "name": "Stream started",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "iconColor": "#199e70",
        "target": {
          "expr": "{container=\"app-jellyfin\"} |= \"started playback of\" | regexp `User (?P<user>.+?) started playback of '(?P<title>.*)' \\(` | line_format \"{{.user}}: {{.title}}\"",
          "refId": "Anno",
          "queryType": "range",
          "maxLines": 300
        },
        "textFormat": "",
        "titleFormat": "Stream started"
      },
      {
        "name": "Stream stopped",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "iconColor": "#898781",
        "target": {
          "expr": "{container=\"app-jellyfin\"} |= \"stopped playback of\" | regexp `User (?P<user>.+?) stopped playback of '(?P<title>.*)' at` | line_format \"{{.user}}: {{.title}}\"",
          "refId": "Anno",
          "queryType": "range",
          "maxLines": 300
        },
        "textFormat": "",
        "titleFormat": "Stream stopped"
      },
      {
        "name": "SyncPlay group waits",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "iconColor": "#ec835a",
        "target": {
          "expr": "{container=\"app-jellyfin\"} |= \"SyncPlay.Group\" |= \"switching from Playing to Waiting\"",
          "refId": "Anno",
          "queryType": "range",
          "maxLines": 300
        },
        "textFormat": "",
        "titleFormat": "SyncPlay group waits"
      },
      {
        "name": "Library scan",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "iconColor": "#c98500",
        "target": {
          "expr": "{container=\"app-jellyfin\"} |= \"Validating media library\"",
          "refId": "Anno",
          "queryType": "range",
          "maxLines": 300
        },
        "textFormat": "",
        "titleFormat": "Library scan"
      }
    ]
  },
  "links": [
    {
      "title": "Homelab dashboards",
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "eno1",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "node_network_up{device=\"eno1\"}",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "no data",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "▲ down",
                  "color": "#d03b3b",
                  "index": 0
                },
                "1": {
                  "text": "● up",
                  "color": "#0ca30c",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Link speed",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "node_network_speed_bytes{device=\"eno1\"} * 8",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "NIC errors",
      "description": "Errors on the NIC in the last 24 hours. This should stay at 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(increase(node_network_receive_errs_total{device=\"eno1\"}[24h]) + increase(node_network_transmit_errs_total{device=\"eno1\"}[24h]))",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true
