    {
      "type": "table",
      "title": "Space free",
      "description": "Free space is the reliable number. A percentage for one dataset is misleading, because datasets share the pool. / is boot-pool. Fast/Telemetry shows its quota.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "node_filesystem_avail_bytes{fstype=\"zfs\",mountpoint=~\"/|/mnt/(Fast|Vault|Fast/Telemetry)\"}",
          "refId": "A",
          "legendFormat": "{{mountpoint}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "device": true,
              "fstype": true
            },
            "renameByName": {
              "Value": "Total",
              "Value #A": "Total"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Total",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "None",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Total"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 170
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 11,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 6
      }
    },
