            ]
          },
          "noValue": "not found",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "■ stopped",
                  "color": "#d03b3b",
                  "index": 0
                },
                "1": {
                  "text": "● running",
                  "color": "#898781",
                  "index": 1
                },
                "2": {
                  "text": "● healthy",
                  "color": "#0ca30c",
                  "index": 2
                },
                "3": {
                  "text": "◐ starting",
                  "color": "#fab219",
                  "index": 3
                },
                "4": {
                  "text": "▲ unhealthy",
                  "color": "#d03b3b",
                  "index": 4
                }
              }
            }
          ]
