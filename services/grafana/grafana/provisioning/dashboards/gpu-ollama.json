{
  "uid": "gpu-ollama",
  "title": "GPU and Ollama",
  "description": "The memory and use of the T400, and Ollama requests.",
  "tags": [
    "homelab",
    "ops",
    "media"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
    "list": [
      {
        "name": "Stream started",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "iconColor": "#199e70",
        "target": {
          "expr": "{container=\"app-jellyfin\"} |= \"started playback of\" | regexp `User (?P<user>.+?) started playback of '(?P<title>.*)' \\(` | line_format \"{{.user}}: {{.title}}\"",
          "refId": "Anno",
          "queryType": "range",
          "maxLines": 300
        },
        "textFormat": "",
        "titleFormat": "Stream started"
      },
      {
        "name": "Stream stopped",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "iconColor": "#898781",
        "target": {
          "expr": "{container=\"app-jellyfin\"} |= \"stopped playback of\" | regexp `User (?P<user>.+?) stopped playback of '(?P<title>.*)' at` | line_format \"{{.user}}: {{.title}}\"",
          "refId": "Anno",
          "queryType": "range",
          "maxLines": 300
        },
        "textFormat": "",
        "titleFormat": "Stream stopped"
      },
      {
        "name": "SyncPlay group waits",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "iconColor": "#ec835a",
        "target": {
          "expr": "{container=\"app-jellyfin\"} |= \"SyncPlay.Group\" |= \"switching from Playing to Waiting\"",
          "refId": "Anno",
          "queryType": "range",
          "maxLines": 300
        },
        "textFormat": "",
        "titleFormat": "SyncPlay group waits"
      },
      {
        "name": "Library scan",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "enable": true,
        "iconColor": "#c98500",
        "target": {
          "expr": "{container=\"app-jellyfin\"} |= \"Validating media library\"",
          "refId": "Anno",
          "queryType": "range",
          "maxLines": 300
        },
        "textFormat": "",
        "titleFormat": "Library scan"
      }
    ]
  },
  "links": [
    {
      "title": "Homelab dashboards",
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "GPU memory",
      "description": "The T400 has 4 GB. Jellyfin and Ollama share it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "nvidia_smi_memory_used_bytes",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 2500000000.0
              },
              {
                "color": "#d03b3b",
                "value": 3500000000.0
              }
            ]
          },
          "noValue": "–"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 2,
