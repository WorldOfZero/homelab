        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "probe_success{app=\"gamescores\"}",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
