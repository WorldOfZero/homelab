    {
      "type": "stat",
      "title": "Application",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "docker_container_running{name=\"gamescores\"} * (docker_container_health{name=\"gamescores\"} + 1)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "not found",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "■ stopped",
                  "color": "#d03b3b",
                  "index": 0
                },
                "1": {
                  "text": "● running",
                  "color": "#898781",
                  "index": 1
                },
                "2": {
                  "text": "● healthy",
                  "color": "#0ca30c",
                  "index": 2
                },
                "3": {
                  "text": "◐ starting",
                  "color": "#fab219",
                  "index": 3
                },
                "4": {
                  "text": "▲ unhealthy",
                  "color": "#d03b3b",
                  "index": 4
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
