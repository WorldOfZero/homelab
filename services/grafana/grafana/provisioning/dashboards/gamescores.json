          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({container=\"gamescores\"} |~ \"^(fail|crit):|Unhandled exception\" [24h]))",
          "refId": "A",
          "queryType": "instant"
