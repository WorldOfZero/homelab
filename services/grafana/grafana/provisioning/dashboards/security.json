    {
      "type": "timeseries",
      "title": "IDS events over time",
      "description": "Internet scanners are normal. An allowed event to a forwarded port shows what is reachable from the internet.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (action) (count_over_time({service=\"unifi-siem\"} |= \"Threat Detected\" | regexp \"act=(?P<action>[a-z]+)\" [$__auto]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "axisPlacement": "auto",
            "gradientMode": "none",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            },
            "lineInterpolation": "linear",
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "table",
      "title": "Targeted ports",
      "description": "An unexpected port here can mean a forward that should not exist.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(10, sum by (port) (count_over_time({service=\"unifi-siem\"} |= \"Threat Detected\" | regexp \"dpt=(?P<port>[0-9]+)\" [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{port}}"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "device": true,
              "fstype": true
            },
            "renameByName": {
              "Value": "Total",
              "Value #A": "Total"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Total",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "None",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Total"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 170
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 6
      }
