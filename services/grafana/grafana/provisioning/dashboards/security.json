    {
      "type": "logs",
      "title": "Threat events",
      "description": "The source, target and detection list of each event.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{service=\"unifi-siem\"} |= \"Threat Detected\" | regexp \"(?P<a>act=[a-z]+).*UNIFIpolicyName=(?P<p>.+?) UNIFIpolicyType.*src=(?P<s>[^ ]+) dst=(?P<d>[^ ]+)\" | line_format \"{{.a}} {{.s}} -> {{.d}} {{.p}}\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
